# ══════════ ASOSIY ══════════
# production / development (production'da xavfsizlik tekshiruvi qat'iy)
ENV=development

# Ma'lumotlar bazasi (default: SQLite fayli). 1000+ bir vaqtdagi yozuv uchun Postgres:
# DATABASE_URL=postgresql+asyncpg://user:parol@localhost:5432/promtchi

# Admin panel paroli (kamida 12 belgi)
ADMIN_PASSWORD=promtchi2026

# JWT maxfiy kaliti — ALBATTA o'zgartiring:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=o'zgartiring-maxfiy-kalit
JWT_EXPIRE_HOURS=12

# ══════════ TELEGRAM (ixtiyoriy) ══════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ══════════ TARMOQ ══════════
# CORS: production'da o'z domeningizni yozing, masalan https://promtchi.uz
CORS_ORIGINS=*

# Nginx/Caddy/Cloudflare ortida ishlaganda ALBATTA true qiling —
# aks holda hamma bitta IP bo'lib ko'rinadi va rate-limit saytni bloklaydi
TRUST_PROXY=false
# X-Forwarded-For zanjirida o'ngdan nechinchi element haqiqiy mijoz
PROXY_HOPS=1

# ══════════ RATE-LIMIT ══════════
# Bitta IP N soniyalik oynada nechta ariza topshira oladi
LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW_SECONDS=600
# Ikki ariza orasidagi minimal vaqt (soniya, 0 = o'chirilgan)
LEAD_MIN_INTERVAL_SECONDS=3
# Umumiy API limiti (IP boshiga, oynada)
API_RATE_LIMIT=600
API_RATE_WINDOW_SECONDS=60

# Login himoyasi: N ta noto'g'ri urinishdan keyin bloklash muddati (soniya)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ══════════ ULANISHLAR PULI (har bir worker uchun alohida) ══════════
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=80
DB_POOL_TIMEOUT=15
