# ══════════ ASOSIY ══════════
# production / development
# ENV=production bo'lganda: /docs va /openapi.json yopiladi, HSTS header
# yuboriladi, admin sessiya cookie'si Secure bo'ladi va xavfsizlik tekshiruvi
# qat'iy ishlaydi. HAQIQIY DOMENDA ALBATTA production qo'ying.
ENV=development

# Ma'lumotlar bazasi (default: SQLite fayli). 1000+ bir vaqtdagi yozuv uchun Postgres:
# DATABASE_URL=postgresql+asyncpg://user:parol@localhost:5432/promtchi

# Admin panel paroli — ADMIN_PASSWORD_HASH tavsiya etiladi (production'da MAJBURIY):
#   python -m app.config hash "yangi-parolingiz"
# Natijadagi qatorni shu yerga qo'ying va ADMIN_PASSWORD qatorini o'chiring.
ADMIN_PASSWORD_HASH=
# Faqat ADMIN_PASSWORD_HASH bo'sh bo'lsa ishlatiladi (development uchun, hash qilinmagan)
ADMIN_PASSWORD=promtchi2026

# JWT maxfiy kaliti — ALBATTA o'zgartiring:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=o'zgartiring-maxfiy-kalit
JWT_EXPIRE_HOURS=12

# ══════════ TELEGRAM (ixtiyoriy) ══════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ══════════ TARMOQ ══════════
# CORS: production'da o'z domeningizni yozing, masalan https://promtchi.uz
CORS_ORIGINS=*

# Saytning haqiqiy domeni — shundan boshqa Host bilan (masalan IP orqali)
# kirilsa bosh sahifa noindex bilan qaytariladi
CANONICAL_HOST=promtchi.uz

# Google Analytics 4 o'lchov ID'si (masalan G-XXXXXXXXXX). Bo'sh qoldirilsa
# gtag/analytics.js hech qaysi sahifaga qo'shilmaydi (TZ 17-bo'lim) va GA
# domenlari CSP'ga ham qo'shilmaydi.
GA_MEASUREMENT_ID=

# Google Search Console tasdiqlash tokeni (HTML-tag usuli). GSC "property"
# qo'shganda beradigan `content="..."` qiymatining O'ZI (meta tegi emas).
# Bo'sh bo'lsa hech qanday meta chiqmaydi.
SEARCH_CONSOLE_VERIFICATION=

# ══════════ ZAXIRA (TZ 20-bo'lim) ══════════
# SQLite bazasidan davriy izchil nusxa (VACUUM INTO + gzip).
# Postgres ishlatilsa false qiling — u yerda pg_dump/managed snapshot ishlaydi.
BACKUP_ENABLED=true
# Zaxira papkasi (default: loyiha ildizidagi backups/)
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
# Nechta oxirgi zaxira saqlansin (qolganlari avtomatik o'chiriladi)
BACKUP_KEEP=7
# Qo'lda: python -m app.backup create | list | restore <fayl>

# Nginx/Caddy/Cloudflare ortida ishlaganda ALBATTA true qiling —
# aks holda hamma bitta IP bo'lib ko'rinadi va rate-limit saytni bloklaydi
TRUST_PROXY=false
# X-Forwarded-For zanjirida o'ngdan nechinchi element haqiqiy mijoz
PROXY_HOPS=1

# ══════════ RATE-LIMIT ══════════
# Bitta IP N soniyalik oynada nechta ariza topshira oladi
LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW_SECONDS=600
# Ikki ariza orasidagi minimal vaqt (soniya, 0 = o'chirilgan)
LEAD_MIN_INTERVAL_SECONDS=3
# Umumiy API limiti (IP boshiga, oynada)
API_RATE_LIMIT=600
API_RATE_WINDOW_SECONDS=60

# Login himoyasi: N ta noto'g'ri urinishdan keyin bloklash muddati (soniya)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ══════════ ULANISHLAR PULI (har bir worker uchun alohida) ══════════
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=80
DB_POOL_TIMEOUT=15
